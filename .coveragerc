# this file is based on the examples provided on scikit-learn's .coveragerc

[run]
source = skbio
branch = True
relative_files = True
omit =
    **/tests/**
    **/test_*.py
    **/__init__.py

[report]
omit =
    **/tests/**
    **/test_*.py
    **/__init__.py
    util/_typing.py
    util/_testing.py
exclude_lines =
    pass
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
